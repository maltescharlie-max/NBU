@model NBU.Data.Models.Student
@{
    ViewData["Title"] = "Editar estudiante";
}
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver al directorio</a><span class="section-kicker">Módulo 01 · Estudiantes</span><h1>Editar expediente</h1><p>Actualiza los datos de @Model.FirstName @Model.LastName.</p></div></section>
<section class="form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_StudentForm" model="Model" />
        <div class="form-footer"><span>Revisa los datos antes de guardar.</span><div><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-brand">Guardar cambios</button></div></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
