@model ChangePasswordViewModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<section class="page-heading"><div><span class="section-kicker">Seguridad</span><h1>Cambiar contraseña</h1><p>Elige una contraseña de al menos 10 caracteres con mayúscula, minúscula, número y símbolo.</p></div></section>
<section class="form-panel auth-form-panel"><form asp-action="ChangePassword" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password"/><span asp-validation-for="CurrentPassword" class="text-danger"></span></div><div class="form-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="NewPassword" class="text-danger"></span></div><div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><div class="form-footer"><span>No compartas tu contraseña.</span><div><a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancelar</a><button class="btn btn-brand" type="submit">Guardar contraseña</button></div></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
