@model IReadOnlyList<StudentScholarshipItem>
@{ ViewData["Title"] = "Becas disponibles"; }
<section class="page-heading"><div><span class="section-kicker">Oportunidades para ti</span><h1>Becas disponibles</h1><p>Revisa los requisitos y solicita las convocatorias abiertas.</p></div></section>
@if (Model.Count == 0) { <div class="data-panel empty-state"><span class="empty-icon">✧</span><h2>No hay convocatorias abiertas</h2><p>Cuando se publique una beca vigente aparecerá en este espacio.</p></div> }
else { <section class="scholarship-grid">@foreach (var item in Model) { <article class="scholarship-card"><div class="scholarship-card-top"><span class="quick-icon icon-scholarship">✧</span><span class="status-pill status-active">Abierta</span></div><h3>@item.Scholarship.Name</h3><p class="scholarship-description">@item.Scholarship.Description</p><div class="student-requirements"><strong>Requisitos</strong><p>@item.Scholarship.Requirements</p></div><div class="scholarship-meta"><span><small>Monto por período</small><strong>@item.Scholarship.Amount.ToString("C2", new System.Globalization.CultureInfo("es-NI"))</strong></span><span><small>Cierra</small><strong>@item.Scholarship.EndDate.ToString("dd/MM/yyyy")</strong></span></div><div class="scholarship-actions">@if (item.ApplicationStatus is null) { <form asp-action="Apply" method="post" enctype="multipart/form-data"><input type="hidden" name="scholarshipId" value="@item.Scholarship.Id"/><label class="form-label">Documento opcional (PDF/JPG/PNG, hasta 5 MB)</label><input class="form-control mb-2" type="file" name="document" accept=".pdf,.jpg,.jpeg,.png"/><button class="btn btn-brand" type="submit">Solicitar beca</button></form> } else { <span class="status-pill status-pending">Solicitud: @StatusLabel(item.ApplicationStatus)</span> }</div></article> }</section> }
@functions { private static string StatusLabel(string status) => status switch { "Pending" => "en revisión", "Accepted" => "aceptada", "Rejected" => "no aprobada", _ => status }; }
