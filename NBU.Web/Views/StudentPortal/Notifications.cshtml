@model StudentNotificationsViewModel
@{ ViewData["Title"] = "Mis notificaciones"; var unread = Model.Notifications.Count(item => !item.IsRead); }
<section class="page-heading"><div><span class="section-kicker">Avisos personales</span><h1>Mis notificaciones</h1><p>Mensajes y novedades dirigidos a tu cuenta.</p></div><div class="unread-summary"><strong>@unread</strong><span>sin leer</span></div></section>
<section class="data-panel"><div class="data-toolbar"><div><h2>Centro de notificaciones</h2><p>Solo tú puedes consultar los avisos de tu cuenta.</p></div></div>
@if (Model.Notifications.Count == 0) { <div class="empty-state"><h3>No tienes notificaciones</h3><p>Los avisos aparecerán aquí cuando el equipo NBU los comparta contigo.</p></div> }
else { <div class="notification-list">@foreach (var item in Model.Notifications) { <article class="notification-card @(item.IsRead ? "" : "notification-unread")"><span class="notification-bell">♧</span><div class="notification-content"><div class="notification-meta"><strong>@(item.Publication?.Title ?? "Aviso NBU")</strong><span>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div><p>@item.Message</p>@if (item.Publication is not null) { <a asp-action="Publications">Ver noticias y eventos →</a> }</div><div class="notification-actions">@if (!item.IsRead) { <form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="notification-mark" type="submit">Marcar leída</button></form> } else { <span class="read-label">Leída</span> }</div></article> }</div> }
</section>
