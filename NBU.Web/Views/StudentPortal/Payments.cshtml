@model StudentPaymentsViewModel
@{ ViewData["Title"] = "Mis pagos"; }
<section class="page-heading"><div><span class="section-kicker">Información de depósitos</span><h1>Mis pagos</h1><p>Consulta únicamente los depósitos que el equipo NBU ha registrado para tus becas.</p></div></section>
<section class="transfer-notice"><div class="transfer-symbol" aria-hidden="true">⇄</div><div><span class="section-kicker">Transferencias bancarias</span><h2>Próximamente</h2><p>Esta opción solo se muestra como referencia. No está habilitada y no envía ni recibe dinero.</p></div><button class="btn btn-transfer-disabled" type="button" disabled aria-disabled="true">No disponible</button></section>
<section class="data-panel"><div class="data-toolbar"><div><h2>Historial de depósitos</h2><p>Total marcado como pagado: <strong>@Model.PaidTotal.ToString("C2", new System.Globalization.CultureInfo("es-NI"))</strong></p></div></div>
@if (Model.Payments.Count == 0) { <div class="empty-state"><h3>No hay depósitos registrados</h3><p>Cuando se registre un depósito asociado a una solicitud aceptada, aparecerá aquí.</p></div> }
else { <div class="table-responsive"><table class="table student-table align-middle"><thead><tr><th>Beca</th><th>Período</th><th>Fecha</th><th>Monto</th><th>Estado</th></tr></thead><tbody>@foreach (var item in Model.Payments) { <tr><td><strong>@item.ScholarshipApplication.Scholarship.Name</strong></td><td>@item.Period</td><td>@item.DepositDate.ToString("dd/MM/yyyy")</td><td><strong>@item.Amount.ToString("C2", new System.Globalization.CultureInfo("es-NI"))</strong></td><td><span class="status-pill @(item.Status == "Paid" ? "status-active" : "status-pending")">@(item.Status == "Paid" ? "Pagado" : "Pendiente")</span></td></tr> }</tbody></table></div> }
</section>
