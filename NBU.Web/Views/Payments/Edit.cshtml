@model NBU.Data.Models.Payment
@{ ViewData["Title"] = "Editar pago"; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a pagos</a><span class="section-kicker">Módulo 03 · Pagos</span><h1>Editar registro</h1><p>Actualiza la información del depósito.</p></div></section>
<section class="form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><partial name="_PaymentForm" model="Model" /><div class="form-footer"><span>Comprueba el monto, fecha y beneficiario.</span><div><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-brand">Guardar cambios</button></div></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
