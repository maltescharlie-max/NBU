@model NBU.Data.Models.Payment
@{ ViewData["Title"] = "Eliminar pago"; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a pagos</a><span class="section-kicker">Módulo 03 · Pagos</span><h1>Eliminar pago</h1><p>Confirma la acción para continuar.</p></div></section>
<section class="delete-panel"><div class="delete-icon">!</div><div><h2>¿Eliminar este registro?</h2><p>Se eliminará el pago de <strong>@Model.ScholarshipApplication.Student.FirstName @Model.ScholarshipApplication.Student.LastName</strong> por <strong>@Model.Amount.ToString("C2", new System.Globalization.CultureInfo("es-NI"))</strong>, correspondiente a @Model.Period.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-danger">Eliminar pago</button></form></div></section>
