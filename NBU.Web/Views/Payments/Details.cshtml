@model NBU.Data.Models.Payment
@{ ViewData["Title"] = "Detalle del pago"; var state = Model.Status switch { "Paid" => "Pagado", "Cancelled" => "Cancelado", _ => "Pendiente" }; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a pagos</a><span class="section-kicker">Módulo 03 · Pagos</span><h1>Detalle del depósito</h1><p>Información registrada del pago.</p></div><a class="btn btn-brand" asp-action="Edit" asp-route-id="@Model.Id">Editar registro</a></section>
<section class="detail-panel"><div class="detail-profile"><span class="avatar-bubble avatar-large">@Model.ScholarshipApplication.Student.FirstName[..1]@Model.ScholarshipApplication.Student.LastName[..1]</span><div><span class="status-pill @(Model.Status == "Paid" ? "status-active" : Model.Status == "Pending" ? "status-pending" : "status-inactive")">@state</span><h2>@Model.ScholarshipApplication.Student.FirstName @Model.ScholarshipApplication.Student.LastName</h2><p>@Model.ScholarshipApplication.Student.StudentCode</p></div></div>
    <dl class="detail-grid"><div><dt>Beca</dt><dd>@Model.ScholarshipApplication.Scholarship.Name</dd></div><div><dt>Monto</dt><dd>@Model.Amount.ToString("C2", new System.Globalization.CultureInfo("es-NI"))</dd></div><div><dt>Período</dt><dd>@Model.Period</dd></div><div><dt>Fecha del depósito</dt><dd>@Model.DepositDate.ToString("dd MMMM yyyy")</dd></div><div><dt>Estado</dt><dd>@state</dd></div></dl>
</section>
