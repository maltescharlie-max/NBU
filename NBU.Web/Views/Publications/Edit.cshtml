@model NBU.Data.Models.Publication
@{ ViewData["Title"] = "Editar publicación"; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a publicaciones</a><span class="section-kicker">Módulo 04 · Noticias y eventos</span><h1>Editar publicación</h1><p>Actualiza “@Model.Title”.</p></div></section>
<section class="form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id" /><partial name="_PublicationForm" model="Model" /><div class="form-footer"><span>Editar el aviso no vuelve a enviar notificaciones.</span><div><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button type="submit" class="btn btn-brand">Guardar cambios</button></div></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
