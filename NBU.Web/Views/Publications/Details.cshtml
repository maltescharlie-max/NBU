@model NBU.Data.Models.Publication
@{ ViewData["Title"] = "Detalle de publicación"; var typeName = Model.Type switch { "News" => "Noticia", "Event" => "Evento", _ => "Aviso" }; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a publicaciones</a><span class="section-kicker">Módulo 04 · @typeName</span><h1>@Model.Title</h1><p>@(Model.Type == "Event" && Model.EventDate is not null ? $"Evento · {Model.EventDate.Value.ToLocalTime():dd MMMM yyyy, HH:mm}" : $"Publicado · {Model.PublishedAt.ToLocalTime():dd MMMM yyyy}")</p></div><a class="btn btn-brand" asp-action="Edit" asp-route-id="@Model.Id">Editar publicación</a></section>
<article class="detail-panel publication-detail"><span class="publication-kind kind-@Model.Type.ToLowerInvariant()">@typeName</span><div class="publication-content">@Model.Content</div><div class="publication-notice-count">Esta publicación generó <strong>@Model.Notifications.Count</strong> notificación(es).</div></article>
