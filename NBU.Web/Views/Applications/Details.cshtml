@model NBU.Data.Models.ScholarshipApplication
@{ ViewData["Title"] = "Detalle de solicitud"; var state = Model.Status switch { "Accepted" => "Aceptada", "Rejected" => "Rechazada", _ => "Pendiente" }; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a solicitudes</a><span class="section-kicker">Módulo 02 · Solicitudes</span><h1>Detalle de solicitud</h1><p>Resultado y datos de la convocatoria.</p></div><a class="btn btn-brand" asp-action="Edit" asp-route-id="@Model.Id">Revisar solicitud</a></section>
<section class="detail-panel"><div class="detail-profile"><span class="avatar-bubble avatar-large">@Model.Student.FirstName[..1]@Model.Student.LastName[..1]</span><div><span class="status-pill @(Model.Status == "Accepted" ? "status-active" : Model.Status == "Pending" ? "status-pending" : "status-inactive")">@state</span><h2>@Model.Student.FirstName @Model.Student.LastName</h2><p>@Model.Student.StudentCode · @Model.Student.Email</p></div></div>
    <dl class="detail-grid"><div><dt>Beca</dt><dd>@Model.Scholarship.Name</dd></div><div><dt>Monto por período</dt><dd>@Model.Scholarship.Amount.ToString("C2", new System.Globalization.CultureInfo("es-NI"))</dd></div><div><dt>Fecha de solicitud</dt><dd>@Model.SubmittedAt.ToLocalTime().ToString("dd MMMM yyyy")</dd></div><div><dt>Estado</dt><dd>@state</dd></div></dl>
    <div class="scholarship-long"><div><h3>Observaciones</h3><p>@(string.IsNullOrWhiteSpace(Model.Observations) ? "Sin observaciones registradas." : Model.Observations)</p></div></div>
</section>
