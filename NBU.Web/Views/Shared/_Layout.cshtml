<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#092754" />
    <title>@ViewData["Title"] · NBU</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NBU.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg app-nav">
            <div class="container-xl">
                <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="NBU, inicio">
                    <img class="brand-logo" src="~/images/nbu-mark.png" alt="Logo de NBU" />
                    <span class="brand-copy"><strong>NBU</strong><small>Nicaragua Becas Universitarias</small></span>
                </a>
                <button class="navbar-toggler nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Panel</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Index">Estudiantes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Registrations">Registros pendientes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Scholarships" asp-action="Index">Becas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Index">Pagos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Publications" asp-action="Index">Noticias y eventos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Notifications" asp-action="Index">Avisos</a></li>
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="StudentPortal" asp-action="Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="StudentPortal" asp-action="Scholarships">Becas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="StudentPortal" asp-action="Applications">Mis solicitudes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="StudentPortal" asp-action="Payments">Mis pagos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="StudentPortal" asp-action="Publications">Noticias</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="StudentPortal" asp-action="Notifications">Avisos</a></li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="account-actions ms-lg-3">
                            <a class="account-name" asp-controller="Account" asp-action="ChangePassword">@User.Identity.Name</a>
                            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-sm btn-outline-secondary">Salir</button></form>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Registrarse</a>
                        <a class="btn btn-brand btn-sm ms-lg-2" asp-controller="Account" asp-action="Login">Ingresar</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main class="container-xl page-shell">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>
    <footer class="app-footer">
        <div class="container-xl d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span><strong>NBU</strong> · Tu esfuerzo abre oportunidades</span>
            <span>Portal Universitario de Becas</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
