@model IEnumerable<NBU.Data.Models.Notification>
@{
    ViewData["Title"] = "Notificaciones";
    var state = ViewData["State"]?.ToString() ?? "";
}
<section class="page-heading"><div><span class="section-kicker">Módulo 04 · Centro de avisos</span><h1>Notificaciones</h1><p>Consulta los avisos generados para estudiantes.</p></div><div class="unread-summary"><strong>@ViewBag.UnreadCount</strong><span>sin leer</span></div></section>
<div class="module-switch"><a class="module-tab" asp-controller="Publications" asp-action="Index">← Publicaciones</a><a class="module-tab @(state == "" ? "active" : "")" asp-action="Index">Todas</a><a class="module-tab @(state == "Unread" ? "active" : "")" asp-action="Index" asp-route-state="Unread">Sin leer</a><a class="module-tab @(state == "Read" ? "active" : "")" asp-action="Index" asp-route-state="Read">Leídas</a></div>
<section class="data-panel">
    @if (!Model.Any())
    {
        <div class="empty-state"><span class="empty-icon">♢</span><h3>No hay notificaciones</h3><p>Al publicar una noticia, evento o aviso puedes generar notificaciones para estudiantes activos.</p><a class="btn btn-brand" asp-controller="Publications" asp-action="Create">Crear publicación</a></div>
    }
    else
    {
        <div class="notification-list">@foreach (var item in Model) {
            <article class="notification-card @(item.IsRead ? "notification-read" : "notification-unread")">
                <span class="notification-bell">✦</span><div class="notification-content"><div class="notification-meta"><strong>@item.Student.FirstName @item.Student.LastName</strong><span>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span></div><p>@item.Message</p><small>@(item.Publication?.Type switch { "Event" => "Evento universitario", "Announcement" => "Aviso institucional", "News" => "Noticia universitaria", _ => "Aviso general" })</small></div>
                <div class="notification-actions">
                    @if (!item.IsRead) { <form asp-action="MarkRead" asp-route-id="@item.Id" method="post"><button class="notification-mark" type="submit">Marcar leída</button></form> } else { <span class="read-label">Leída</span> }
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar esta notificación del historial?');"><button class="notification-delete" type="submit" aria-label="Eliminar notificación">×</button></form>
                </div>
            </article>
        }</div>
    }
</section>
