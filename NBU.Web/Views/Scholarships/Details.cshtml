@model NBU.Data.Models.Scholarship
@{ ViewData["Title"] = "Detalle de beca"; }
<section class="page-heading"><div><a class="back-link" asp-action="Index">← Volver a becas</a><span class="section-kicker">Módulo 02 · Convocatorias</span><h1>@Model.Name</h1><p>Información y requisitos de la convocatoria.</p></div><a class="btn btn-brand" asp-controller="Applications" asp-action="Create" asp-route-scholarshipId="@Model.Id">＋ Registrar solicitud</a></section>
<section class="detail-panel scholarship-detail">
    <div class="detail-profile"><span class="quick-icon icon-scholarship detail-scholarship-icon">✧</span><div><span class="status-pill @(Model.Status == "Open" ? "status-active" : "status-inactive")">@(Model.Status == "Open" ? "Abierta" : Model.Status == "Closed" ? "Cerrada" : Model.Status)</span><h2>@Model.Name</h2><p>@Model.Amount.ToString("C2", new System.Globalization.CultureInfo("es-NI")) por período</p></div></div>
    <div class="scholarship-long"><div><h3>Descripción</h3><p>@Model.Description</p></div><div><h3>Requisitos</h3><p class="requirements-text">@Model.Requirements</p></div></div>
    <dl class="detail-grid"><div><dt>Inicio de convocatoria</dt><dd>@Model.StartDate.ToString("dd MMMM yyyy")</dd></div><div><dt>Fecha de cierre</dt><dd>@Model.EndDate.ToString("dd MMMM yyyy")</dd></div><div><dt>Solicitudes recibidas</dt><dd>@Model.Applications.Count</dd></div></dl>
    @if (Model.Applications.Any()) { <div class="related-applications"><h3>Solicitudes recientes</h3>@foreach (var application in Model.Applications.OrderByDescending(item => item.SubmittedAt).Take(5)) { <div><span>@application.Student.FirstName @application.Student.LastName</span><span class="status-pill @(application.Status == "Accepted" ? "status-active" : "status-inactive")">@(application.Status == "Pending" ? "Pendiente" : application.Status == "Accepted" ? "Aceptada" : "Rechazada")</span></div> }<a asp-controller="Applications" asp-action="Index">Ver todas las solicitudes →</a></div> }
</section>
